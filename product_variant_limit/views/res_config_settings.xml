<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product_variant_limit</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="31"/>
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='product_setting_container']" position="inside" >
                    <div class="col-12 col-lg-6 o_setting_box"
                        id="product_dynamic_variant_limit"
                        title="Product Variant Limit">
                        <div class="o_setting_left_pane">
                            <field name="dynamic_product_variant_limit"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="dynamic_product_variant_limit"/>
                            <div class="text-muted">
                                Set product variant creation limit
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
